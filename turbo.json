{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "generate"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["generate"],
      "persistent": true
    },
    "generate": {
      "cache": false,
      "env": ["DATABASE_URL", "NODE_ENV"]
    },
    "lint": {
      "dependsOn": ["^lint", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    }
  }
}
