# Values here match `docker compose up`, so copying this file is enough to run
# the API on the host with `bun run dev` while the services run in Docker.
# Ports differ from the in-network ones because compose publishes them.

# App
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
# Connections in the pool, and how long one statement may run before Postgres
# cancels it. The migrator ignores both so a long migration is never cut short.
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# Sessions
SESSIONS_REDIS_URL=redis://localhost:6380
SESSIONS_TTL_SECONDS=604800
SESSIONS_KEY_PREFIX=velo:sessions:

# Jobs
JOBS_REDIS_URL=redis://localhost:6379

# Cache
CACHE_REDIS_URL=redis://localhost:6381

# Rate limiting
# Counters need persistence and no eviction, so they default to the sessions
# server rather than the cache one. Set this only to move them elsewhere.
# RATE_LIMIT_REDIS_URL=redis://localhost:6380

# Mail
SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@velo.local
MAIL_FROM_NAME=Velo
MAIL_FROM_ADDRESS=no-reply@velo.local
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# Proxy
# Leave TRUSTED_PROXY_HEADER unset unless a proxy you control sits in front of
# the API: forwarded headers are attacker-controlled, so an IP is only read from
# one when it is named here. Depth counts the trusted proxies in the chain.
# TRUSTED_PROXY_HEADER=x-forwarded-for
# TRUSTED_PROXY_DEPTH=1

# OAuth
# Each provider is enabled by supplying both of its values; a provider without
# them returns 404. OAUTH_STATE_SECRET (32+ bytes) is required as soon as any
# provider is configured, and OAUTH_REDIRECT_BASE is the API's own origin, used
# to build the callback URL you register with the provider.
# OAUTH_STATE_SECRET=
# OAUTH_REDIRECT_BASE=http://localhost:8080
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Logging
# LOG_LEVEL=info
# LOG_PRETTY=true
